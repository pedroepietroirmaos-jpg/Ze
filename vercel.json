{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/wait", "dest": "/public/wait.html" },
    { "src": "/success", "dest": "/public/success.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}